{
  "enabledPlugins": {
    "email@holdco-fleet": true
  },
  "fallbackModel": ["claude-sonnet-4-6", "claude-haiku-4-5"],
  "permissions": {
    "deny": ["AskUserQuestion"]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'open=$(find tasks -name \"*.md\" ! -name \"_*\" 2>/dev/null | xargs grep -l \"^status: open\" 2>/dev/null | wc -l | tr -d \" \"); echo \"=== Post-compact context: {{TITLE}} — {{TAGLINE}} | persona: .claude/agents/operator.md | rules: AGENTS.md | $open open task(s) in TASKS.md | log each pass in your commit message ===\"'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/trim-bash-output.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-snapshot.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "${CLAUDE_PROJECT_DIR}/bin/usage-statusline",
    "padding": 0
  }
}
