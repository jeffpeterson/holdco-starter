#!/usr/bin/env bash
#
# operator-loop — supervise a long-running `claude` operator so its OS process
# memory is reclaimed before it can balloon and OOM the box.
#
# WHY: every operator (and holdco itself) runs as `claude … /loop /clear …`.
# `/loop /clear` resets the CONTEXT WINDOW each pass but NOT the process RSS,
# which creeps up over hours/days — one recently ballooned to ~22GB and locked
# the owner out of SSH. This wrapper is the PROACTIVE, graceful layer that
# recycles a session before it gets there (earlyoom is the last-resort backstop).
#
# HOW: claude is run as a child in a restart loop. A lightweight watchdog polls
# the claude process subtree's RSS and recycles (graceful SIGTERM → SIGKILL) when
# it crosses a cap or outlives a max lifetime. When claude exits — by recycle,
# crash, or otherwise — it is relaunched with --resume <pinned-id>, which resumes
# the SAME session thread (so SESSIONS.md links + the remote-control conversation
# stay valid and the operator's loop is unbroken). The relaunch is a fresh OS
# process, so the leaked RSS is reclaimed; --resume merely rehydrates the convo.
#
# SESSION PINNING: we do NOT use `claude --continue` — it resumes the most-recently
# MODIFIED session file in the project dir, and the project dir holds many session
# transcripts (every fork/subagent/relaunch writes one), so the newest-mtime file
# is frequently NOT this operator's live conversation (observed: relaunch dropped
# the owner into an old, unrelated convo). Instead we pin one durable uuid per
# operator (persisted in the .session file beside the log), launch fresh with
# --session-id <uuid>, and on every relaunch resume that exact id with
# --resume <uuid>. This is immune to the multi-writer mtime race.
#
# LIFETIME RECYCLE IS ACTIVITY-AWARE: the RSS cap is a hard, unconditional kill
# (a ballooning process can lock the box). The LIFETIME cap is softer — it waits
# for the operator's tmux window to go quiet (no activity for OPERATOR_QUIET_SECS)
# before recycling, so it can't interrupt the operator (or the owner, steering
# interactively) mid-conversation. A hard ceiling (MAX_LIFETIME*LIFETIME_HARD_MULT)
# recycles regardless so a perpetually-chatty pane can't defer forever.
#
# OFF-SWITCH: this wrapper relaunches on any exit (that's the point — crash
# resilience). To take an operator offline, kill its tmux WINDOW (e.g.
# `bin/holdco shutter <id>` or `tmux kill-window`), which kills the wrapper too.
#
# USAGE: operator-loop <claude-arg>...
#   The args are everything AFTER `claude` (flags + opening prompt). They are
#   passed verbatim alongside --session-id on first launch; restarts add --resume.
#
# CONFIG (env, all overridable):
#   OPERATOR_RSS_MAX_MB    recycle when the claude subtree RSS exceeds this MB   (default 3000)
#   OPERATOR_MAX_LIFETIME  soft lifetime cap; recycle once quiet, e.g. 4h/90m    (default 4h)
#   OPERATOR_GRACE_SECS    SIGTERM→SIGKILL grace window on recycle              (default 120)
#   OPERATOR_POLL_SECS     watchdog poll interval                              (default 30)
#   OPERATOR_QUIET_SECS    window must be quiet this long for a lifetime recycle (default 360)
#   OPERATOR_LIFETIME_HARD_MULT  hard ceiling = MAX_LIFETIME × this, recycle anyway (default 3)
#   OPERATOR_NO_RECYCLE    set to 1 to disable the watchdog (restart-on-exit only)
#
# NOTE: no `set -e` — claude exiting non-zero (SIGTERM/SIGINT/crash) is the
# NORMAL case here and must not abort the supervisor.
set -uo pipefail

RSS_MAX_MB=${OPERATOR_RSS_MAX_MB:-3000}
GRACE_SECS=${OPERATOR_GRACE_SECS:-120}
POLL_SECS=${OPERATOR_POLL_SECS:-30}
QUIET_SECS=${OPERATOR_QUIET_SECS:-360}        # lifetime recycle waits for window quiet this long
LIFETIME_HARD_MULT=${OPERATOR_LIFETIME_HARD_MULT:-3}  # hard ceiling = MAX_LIFETIME × this
MIN_UPTIME=60            # exits faster than this count as crashes
MAX_CRASHES=5            # consecutive rapid crashes before the wrapper gives up

# Parse a duration like "4h" / "90m" / "3600" into seconds.
to_secs() {
  local d=${1:-0}
  case "$d" in
    *h) echo $(( ${d%h} * 3600 )) ;;
    *m) echo $(( ${d%m} * 60 )) ;;
    *s) echo "${d%s}" ;;
    *)  echo "$d" ;;
  esac
}
MAX_LIFETIME=$(to_secs "${OPERATOR_MAX_LIFETIME:-4h}")

# Durable per-operator log. The stderr line lands in volatile tmux scrollback and
# is lost; also append every event to a greppable file so recycle vs crash vs OOM
# is reconstructable after the fact. Slug is derived from --remote-control.
slug=unknown
prev=""
for arg in "$@"; do
  if [[ $prev == --remote-control ]]; then
    slug=$(echo "$arg" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-')
    slug=${slug#-}; slug=${slug%-}
    break
  fi
  prev=$arg
done
[[ -z $slug ]] && slug=unknown
LOG_DIR="${HOME}/.claude/operator-loop"
LOG_FILE="${LOG_DIR}/${slug}.log"
SESSION_FILE="${LOG_DIR}/${slug}.session"   # the one durable session id for this operator
mkdir -p "$LOG_DIR"

log() {
  echo "operator-loop: $*" >&2
  echo "$(date '+%FT%T%z') $*" >> "$LOG_FILE"
}

# A fresh random uuid for a new pinned session (uuidgen, kernel fallback).
new_uuid() {
  if command -v uuidgen >/dev/null 2>&1; then
    uuidgen | tr '[:upper:]' '[:lower:]'
  else
    cat /proc/sys/kernel/random/uuid
  fi
}

# Decide whether the LIFETIME cap should recycle NOW. Pure/testable:
#   should_lifetime_recycle <elapsed> <quiet>
# elapsed = seconds claude has been up; quiet = seconds the tmux window has been
# idle (-1 if unknown — no tmux). Recycle once past MAX_LIFETIME AND the window is
# quiet for QUIET_SECS; or unconditionally past the hard ceiling; or (no tmux)
# fall back to the old lifetime-only behavior. Echoes the reason and returns 0 to
# recycle, 1 to defer.
should_lifetime_recycle() {
  local elapsed=$1 quiet=$2 hard=$(( MAX_LIFETIME * LIFETIME_HARD_MULT ))
  (( MAX_LIFETIME > 0 )) || return 1
  if (( LIFETIME_HARD_MULT > 0 && elapsed > hard )); then
    echo "lifetime-hard ${elapsed}s > ${hard}s ceiling"; return 0
  fi
  (( elapsed > MAX_LIFETIME )) || return 1
  if (( quiet < 0 )); then
    echo "lifetime ${elapsed}s > ${MAX_LIFETIME}s cap (no tmux — activity-blind)"; return 0
  fi
  if (( quiet >= QUIET_SECS )); then
    echo "lifetime ${elapsed}s > ${MAX_LIFETIME}s cap, window quiet ${quiet}s"; return 0
  fi
  return 1   # past lifetime but window still active — defer
}

# Seconds since the operator's tmux window last had activity, or -1 if unknown.
# The watchdog runs inside the operator's pane; $TMUX_PANE identifies it.
window_quiet_secs() {
  local act
  [[ -n ${TMUX_PANE:-} ]] || { echo -1; return; }
  act=$(tmux display-message -p -t "$TMUX_PANE" '#{window_activity}' 2>/dev/null)
  [[ $act =~ ^[0-9]+$ ]] || { echo -1; return; }
  echo $(( $(date +%s) - act ))
}

# All descendant PIDs of a process (depth-first).
descendants() {
  local p child
  for child in $(pgrep -P "$1" 2>/dev/null); do
    echo "$child"
    descendants "$child"
  done
}

# Summed RSS (MB) of a process and its whole subtree.
subtree_rss_mb() {
  local root=$1 total=0 p r
  for p in "$root" $(descendants "$root"); do
    r=$(ps -o rss= -p "$p" 2>/dev/null | tr -d ' ')
    [[ -n $r ]] && total=$(( total + r ))
  done
  echo $(( total / 1024 ))
}

# Watchdog: recycle claude when it exceeds the RSS cap or the lifetime cap.
# Discovers the claude child of the wrapper (claude runs in the FOREGROUND so it
# keeps the pane TTY — backgrounding it would send stdin to /dev/null and break
# `tmux attach` steering). On trigger it touches the recycle-flag (so the parent
# knows the exit was intentional) then escalates SIGTERM → SIGKILL.
watchdog() {
  local wrapper_pid=$1 self=$BASHPID cpid="" start now rss reason waited tries=0
  # claude is the wrapper's only direct child other than this watchdog subshell,
  # so identify it by exclusion — robust to however claude names its process.
  while [[ -z $cpid ]] && (( tries < 60 )); do
    cpid=$(pgrep -P "$wrapper_pid" 2>/dev/null | grep -vx "$self" | head -1)
    [[ -n $cpid ]] && break
    sleep 1; tries=$(( tries + 1 ))
  done
  [[ -z $cpid ]] && return
  start=$(date +%s)
  while kill -0 "$cpid" 2>/dev/null; do
    sleep "$POLL_SECS"
    kill -0 "$cpid" 2>/dev/null || break
    now=$(date +%s)
    rss=$(subtree_rss_mb "$cpid")
    reason=""
    # RSS cap: HARD, unconditional kill — the safety net against a ballooning
    # process locking the box. Never deferred for activity.
    if (( RSS_MAX_MB > 0 && rss > RSS_MAX_MB )); then
      reason="RSS-hard ${rss}MB > ${RSS_MAX_MB}MB cap"
    else
      # Lifetime cap: activity-aware — defer while the tmux window is busy so we
      # don't recycle mid-conversation; hard ceiling forces it eventually.
      reason=$(should_lifetime_recycle "$(( now - start ))" "$(window_quiet_secs)")
    fi
    [[ -z $reason ]] && continue

    log "recycling (${reason}) — SIGTERM, ${GRACE_SECS}s grace"
    : > "$RECYCLE_FLAG"
    kill -TERM "$cpid" 2>/dev/null
    waited=0
    while kill -0 "$cpid" 2>/dev/null && (( waited < GRACE_SECS )); do
      sleep 2; waited=$(( waited + 2 ))
    done
    if kill -0 "$cpid" 2>/dev/null; then
      log "grace elapsed — SIGKILL"
      kill -KILL "$cpid" 2>/dev/null
    fi
    return
  done
}

# --- supervise ---------------------------------------------------------------

RECYCLE_FLAG=$(mktemp -t operator-loop.recycle.XXXXXX)
WATCH_PID=""

cleanup() {
  pkill -P $$ 2>/dev/null   # reap claude + watchdog children on teardown
  rm -f "$RECYCLE_FLAG"
}
trap cleanup EXIT
trap 'exit 143' TERM HUP INT   # tmux window killed → cleanup runs via EXIT trap

crashes=0
while true; do
  rm -f "$RECYCLE_FLAG"

  WATCH_PID=""
  if [[ "${OPERATOR_NO_RECYCLE:-0}" != "1" ]]; then
    watchdog "$$" &          # discovers the foreground claude child by PID
    WATCH_PID=$!
  fi

  # Resolve the pinned session: resume the persisted id, or mint a fresh one and
  # persist it. claude runs in the FOREGROUND so it inherits the pane TTY
  # (stdin/out) — essential for the TUI and `tmux attach` steering.
  if [[ -s $SESSION_FILE ]]; then
    SESSION_ID=$(<"$SESSION_FILE")
    mode=resume
  else
    SESSION_ID=$(new_uuid)
    printf '%s\n' "$SESSION_ID" > "$SESSION_FILE"
    log "session pinned: $SESSION_ID"
    mode=fresh
  fi

  started=$(date +%s)
  if [[ $mode == resume ]]; then
    log "resuming session: $SESSION_ID"
    claude --resume "$SESSION_ID" "$@"
  else
    log "launching (fresh session): $SESSION_ID"
    claude --session-id "$SESSION_ID" "$@"
  fi
  status=$?
  ended=$(date +%s)

  [[ -n $WATCH_PID ]] && { kill "$WATCH_PID" 2>/dev/null; wait "$WATCH_PID" 2>/dev/null; }
  WATCH_PID=""

  if [[ -e $RECYCLE_FLAG ]]; then
    crashes=0
    log "recycled — relaunching (resume $SESSION_ID)"
    continue
  fi

  uptime=$(( ended - started ))

  # Resume of a dead/corrupt session: a fast nonzero exit right after --resume.
  # Drop the pinned id so the next iteration mints a brand-new one and launches it
  # FRESH (via --session-id) — don't crash-loop trying to resume a bad id. A fresh
  # launch that also fails fast falls through to the normal crash backoff below.
  if [[ $mode == resume ]] && (( status != 0 && uptime < MIN_UPTIME )); then
    log "resume of $SESSION_ID failed (status $status after ${uptime}s) — minting a fresh session"
    rm -f "$SESSION_FILE"
    continue
  fi

  if (( uptime < MIN_UPTIME )); then
    crashes=$(( crashes + 1 ))
    if (( crashes >= MAX_CRASHES )); then
      log "claude exited (status $status) after ${uptime}s — $crashes rapid exits in a row, giving up"
      exit "$status"
    fi
    backoff=$(( crashes * 5 ))
    log "claude exited (status $status) after ${uptime}s — relaunch #$crashes in ${backoff}s"
    sleep "$backoff"
  else
    crashes=0
    log "claude exited (status $status) after ${uptime}s — relaunching (resume)"
  fi
done
