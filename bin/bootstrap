#!/usr/bin/env bash
#
# bin/bootstrap — the ONE command to stand up a fresh holdco clone.
#
# There is deliberately NO config Q&A here. Configuration is a CONVERSATION with
# Claude, not a shell script: this does a bare prerequisite check, then launches
# `claude` with the holdco persona in first-run setup mode. The operator then
# walks you through the fleet (owner email, models, and the optional email
# channel / task board / GitHub), writes .env and everything else with its own
# tools, moves itself into a persistent tmux session, and starts operating.
#
#   bin/bootstrap          launch the first-run setup conversation
#   bin/bootstrap --check  prerequisite check only (non-interactive, CI-safe)
#   bin/bootstrap --help
#
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  sed -n '3,15p' "$0" | sed 's/^# \{0,1\}//'
  exit 0
fi

# ---- bare prerequisite check ------------------------------------------------
case "$(uname -s)" in
  Linux) ;;
  *) echo "! Not Linux ($(uname -s)). The /proc-based orphan reaping in bin/holdco is" >&2
     echo "  Linux-only; supervision may misbehave on this platform." >&2 ;;
esac

missing=()
for c in claude git ruby rake tmux; do
  command -v "$c" >/dev/null 2>&1 || missing+=("$c")
done
if [ "${#missing[@]}" -gt 0 ]; then
  echo "bootstrap: missing required tools: ${missing[*]}" >&2
  echo "  claude → https://docs.claude.com/en/docs/claude-code" >&2
  echo "  the rest → apt install <tool>  /  brew install <tool>" >&2
  exit 1
fi

if [ "${1:-}" = "--check" ]; then
  echo "bootstrap: prerequisites present (claude git ruby rake tmux)."
  echo "  Run bin/bootstrap with no args to start the setup conversation."
  exit 0
fi

command -v claude >/dev/null 2>&1 || { echo "bootstrap: claude not found" >&2; exit 1; }

# ---- hand off to Claude: configuration is a conversation --------------------
# Launch an interactive claude in THIS terminal, seeded with the first-run
# instruction. The persona's "First-run setup" section drives the rest: it
# configures the fleet with you, writes .env, then relaunches itself in tmux as
# the persistent operator (bin/holdco-up) and hands off.
exec claude \
  --append-system-prompt-file .claude/agents/holdco.md \
  --model "${HOLDCO_MODEL:-sonnet}" \
  "This is a FRESH holdco clone and there is no .env yet. Run FIRST-RUN SETUP now, exactly per the 'First-run setup' section of your persona: configure the fleet with me conversationally, write .env and any other config with your own tools, then create the tmux session and relaunch yourself there as the persistent operator, and hand off to your normal operating loop."
