# .env.example — the template holdco fills into .env. NEVER commit .env itself.
# You don't edit this by hand: on first run you tell holdco your config in
# conversation and it writes .env from this template. This file documents every knob.
#
# Legend:
#   [owner-provided]   Must be issued/retrieved by you from the service dashboard.
#   [regenerable]      Can be minted fresh from the relevant service (Cloudflare, etc.)
#                      without owner involvement — just needs the right account access.
#
# CORE works with ZERO of the optional sections below. Email + the two Workers are opt-in.

# --- location ----------------------------------------------------------------
# Absolute path to this holdco checkout — holdco sets this on first run; operators and
# venture tooling resolve holdco (bin/email, bin/holdco, secrets) via this. holdco is
# location-independent: clone it anywhere and it fills this in during setup.
HOLDCO_ROOT=

# --- core identity -----------------------------------------------------------
# Your email — where the fleet sends owner-facing mail and digests.
OWNER_EMAIL=owner@example.com

# Verified sending subdomain every fleet address lives on, e.g. bot.example.com.
# Each operator gets <id>@<this domain>. Leave BLANK to disable all email features.
FLEET_EMAIL_DOMAIN=

# --- GitHub (optional — only needed to push venture repos) --------------------
# GitHub personal access token (repo + workflow scopes).
# [owner-provided] — issue at https://github.com/settings/tokens
GITHUB_PAT=

# --- email channel (OPTIONAL — Resend / Cloudflare Email) --------------------
# Powers bin/email, the inbox Worker, and `bin/holdco mail`. See docs/EMAIL.md.
# Leave these blank (and FLEET_EMAIL_DOMAIN above blank) to run with no email.

# Cloudflare API token for email sending (scoped to Email: Send) / routing.
# [regenerable] — https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_EMAIL_TOKEN=

# Cloudflare account ID (not a secret — safe to look up in the dashboard).
# [regenerable] — visible at https://dash.cloudflare.com → right sidebar
HOLDCO_CF_ACCOUNT_ID=

# KV namespace ID for the inbox Worker (not a secret — just an ID).
# [regenerable] — create in Cloudflare Dashboard → Workers & Pages → KV
HOLDCO_INBOX_KV_NAMESPACE=

# Cloudflare API token for the inbox Worker (scoped to Workers KV: Edit).
# [regenerable] — https://dash.cloudflare.com/profile/api-tokens
HOLDCO_INBOX_CF_TOKEN=

# --- tasks board Worker (OPTIONAL — Cloudflare D1) ---------------------------
# A hosted kanban board + REST API for tasks. When TASKS_WORKER_URL is BLANK the
# tool uses the local git-backed tasks/ backlog instead (fully functional).

# Cloudflare API token for the tasks Worker (scoped to Workers: Edit + D1: Edit).
# [regenerable] — https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_TASKS_TOKEN=

# Base URL of YOUR deployed tasks Worker (not a secret). BLANK = local tasks/ backlog.
# e.g. https://your-tasks-worker.example.workers.dev
TASKS_WORKER_URL=

# Owner-level bearer token for the tasks Worker API (full read/write).
# [regenerable] — set in the Worker's environment variables (Cloudflare Dashboard)
TASKS_OWNER_TOKEN=

# Agent-level bearer token for the tasks Worker API (task CRUD, no admin).
# [regenerable] — set in the Worker's environment variables (Cloudflare Dashboard)
TASKS_AGENT_TOKEN=

# --- tunables (OPTIONAL — all have sensible built-in defaults) ----------------
# See docs/CONFIG.md for the full list.
#   HOLDCO_MODEL          supervisor model alias            (default: sonnet)
#   OP_MODEL              operator model alias              (default: sonnet)
#   HOLDCO_TMUX_SESSION   tmux session name                 (default: holdco)
#   VENTURES_ROOT         where new venture repos scaffold  (default: HOLDCO_ROOT's
#                         parent dir — i.e. ventures are siblings of holdco). Override
#                         to scaffold ventures elsewhere; existing ventures can live
#                         anywhere (their path is recorded per-venture in ventures/<id>.md).
# HOLDCO_MODEL=sonnet
# OP_MODEL=sonnet
# HOLDCO_TMUX_SESSION=holdco
# VENTURES_ROOT=

# --- operator memory recycling (bin/operator-loop) ---------------------------
# Long-running operators are supervised by bin/operator-loop, which recycles the
# claude process before its RSS can balloon and OOM the box. Defaults are baked in;
# set these only to override (not secrets). See bin/operator-loop for the full list.
#   OPERATOR_RSS_MAX_MB    recycle when the claude subtree RSS exceeds this   (default 3000)
#   OPERATOR_MAX_LIFETIME  recycle after this long regardless, e.g. 4h/90m    (default 4h)
# OPERATOR_RSS_MAX_MB=3000
# OPERATOR_MAX_LIFETIME=4h
