# Local scratch
/tmp/
*.log
.DS_Store

# imagegen scratch — generated candidates; ship a chosen one by copying it into tracked assets
assets/imagegen/

# Dream-cycle cadence marker — local timestamp, not a tracked artifact
docs/dreams/.last

# Editor
.idea/
.vscode/
*.swp

.env

# asks state — content hashes of surfaced operator questions/blockers
.holdco/

# Wrangler build cache
services/tasks/.wrangler/

# Scaffolded venture repos (VENTURES_ROOT default: ventures/<id>/, a nested repo
# per business, each git-inited on its own). Never ship a user's actual businesses
# in the starter's history — only the lightweight ventures/<id>.md registry files
# (and _template.md) are tracked.
ventures/*/
